# Copy this file to ../.env and fill in the values you need.
# The ML backend itself does not require an AI key —
# these are only read by the frontend Node server (ai.server.ts).

# ── AI provider (pick ONE) ────────────────────────────────────────────────────
# LOVABLE_API_KEY=your_lovable_key_here
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=your_gemini_key_here

# ── Backend server ────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000

# ── ML Backend URL (consumed by the frontend Node server) ────────────────────
# ML_BACKEND_URL=http://localhost:8000
